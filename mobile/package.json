{
  "name": "bitaxe-baller-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrapper for Bitaxe Baller — iOS + Android apps that talk to relay.bitaxeballer.com",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap run ios",
    "android": "npm run sync && cap run android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
