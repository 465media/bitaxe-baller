# Bitaxe Baller — Android release signing config (TEMPLATE)
#
# 1. Generate your production keystore — see mobile/marketing/android-release-build.md
#    for the exact `keytool` command. NEVER let an AI/agent generate this for you.
# 2. Copy this file to `keystore.properties` (same directory: mobile/android/)
# 3. Fill in the four values below
# 4. Back up the .jks file + this filled properties file to a password manager
#    (1Password recommended) AND an offline disk. Losing the keystore = losing
#    the Play Store listing forever (Google cannot help you recover it).
#
# This file (the .example) is checked into git. The real `keystore.properties`
# and any *.jks / *.keystore files are gitignored.

# Path to the .jks keystore, relative to mobile/android/ (the rootProject dir).
# Example: storeFile=keystore/bitaxe-baller-release.jks
# Recommended: keep the .jks OUTSIDE the repo and use an absolute path, e.g.
# storeFile=/Users/nbaldwin/keys/bitaxe-baller-release.jks
storeFile=

# Password for the keystore file itself (set when you ran `keytool -genkey`).
storePassword=

# Alias of the key inside the keystore (the `-alias` arg you passed to keytool).
# Recommended: bitaxe-baller
keyAlias=

# Password for the key entry (often the same as storePassword — keytool will ask
# "RETURN if same as keystore password" during generation).
keyPassword=
