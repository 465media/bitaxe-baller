# Node
node_modules/

# Build outputs
dist/

# iOS — most is generated by `cap sync` but a few user-touched files do persist.
# Keep ios/App/App/Info.plist + the .xcodeproj structure; ignore Pods + DerivedData.
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/DerivedData/
ios/App/Podfile.lock

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/app/release/
android/app/debug/

# Capacitor — copied from www/ on sync, regenerable
ios/App/App/public/
android/app/src/main/assets/public/

# Misc
.DS_Store
*.log
